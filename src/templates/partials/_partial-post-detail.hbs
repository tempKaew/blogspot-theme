<b:with value="data:posts" var="posts">
  <b:loop index="i" values="data:posts" var="post">
    <article class="post">

      <header>
        <b:if cond="data:post.labels">
          <div class="labels">
            <b:loop values="data:post.labels" var="label">
              <a expr:href="data:label.url" class="label" rel="tag">
                <data:label.name />
              </a>
            </b:loop>
          </div>
        </b:if>

        <h1 class="card-title">
          <b:eval
            expr='data:post.title.escaped != "" ? data:post.title.escaped : data:messages.noTitle'
          />
        </h1>
        <p class="post-meta">
          <data:post.date />
        </p>
      </header>

      <div class="content">
        <data:post.body />
      </div>
    </article>
  </b:loop>
</b:with>