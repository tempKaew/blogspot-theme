<b:with value="data:posts" var="posts">
  <b:loop index="i" values="data:posts" var="post">
    <article class="post">

      <header>

        {{> partial-breadcrumbs}}

        <h1 class="card-title">
          <b:eval
            expr='data:post.title.escaped != "" ? data:post.title.escaped : data:messages.noTitle'
          />
        </h1>
        <p class="post-meta">
          <data:post.date />
        </p>
      </header>

      <div class="content">
        <data:post.body />
      </div>

      <div class="post-related">
        <script type="text/javascript">/*<![CDATA[*/{{asset
            "dist/js/related_post.min.js"
          }}/*]]>*/</script>
      </div>

    </article>
  </b:loop>
</b:with>