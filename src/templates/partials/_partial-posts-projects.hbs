<header class="page-hero">
  {{> partial-kicker text="PORTFOLIO / OPEN SOURCE"}}
  <h2 class="page-hero__title">Projects</h2>
  <p class="page-hero__desc">โปรเจกต์ เครื่องมือ และ boilerplate ที่สร้างขึ้นเพื่อแก้ปัญหาจริง แล้วเปิดให้คนอื่นเอาไปใช้ต่อ</p>
  <div class="stat-strip">
    <div>
      <span class="stat-strip__label">Stack</span>
      <span class="stat-strip__value">Rust &amp; PHP</span>
    </div>
    <div>
      <span class="stat-strip__label">Workflow</span>
      <span class="stat-strip__value stat-strip__value--accent">Docker</span>
    </div>
  </div>
  {{> partial-chips set="projects"}}
</header>
<div class="posts">
  <b:loop index="i" values="data:posts" var="post">
    <article class="card project-card post">
      <a class="project-card__media" expr:href="data:post.url">
        <b:if cond="data:post.featuredImage">
          <img expr:src="data:post.featuredImage" expr:alt="data:post.title.escaped" loading="lazy" />
          <b:else />
          <span class="project-card__placeholder"></span>
        </b:if>
      </a>
      <div class="project-card__body">
        <b:if cond="data:post.labels">
          <div class="project-card__tags">
            <b:loop index="i" values="data:post.labels" var="label">
              <b:if cond='data:label.name != "projects"'>
                <a class="badge" expr:href="data:label.url.canonical"><data:label.name /></a>
              </b:if>
            </b:loop>
          </div>
        </b:if>
        <h3 class="project-card__title">
          <a expr:href="data:post.url">
            <b:eval expr='data:post.title.escaped != "" ? data:post.title.escaped : data:messages.noTitle' />
          </a>
        </h3>
        <p class="project-card__excerpt"><data:post.snippets.short /></p>
        <div class="project-card__foot">
          <a class="btn btn--ghost btn--sm" expr:href="data:post.url">อ่านบทความ<span class="visually-hidden"> <b:eval expr='data:post.title.escaped != "" ? data:post.title.escaped : data:messages.noTitle' /></span></a>
        </div>
      </div>
    </article>
  </b:loop>
</div>
<b:include name="nextPrev" />
