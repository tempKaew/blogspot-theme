<h2>
  <b:if cond="data:view.isSingleItem or data:view.isHomepage">
    Recent posts
    <b:elseif cond="data:view.isSearch" />
    <b:if cond="data:view.search.label">
      <b:eval expr='"Articles tag : " + data:view.search.label.escaped' />
      <b:elseif cond="data:view.search.query" />
      <b:eval expr='"ผลการค้นหา : " + data:view.search.query.escaped' />
      <b:else />
      Blog
    </b:if>
  </b:if>
</h2>
<div class="posts">
  <b:with
    value="data:view.isHomepage ? data:posts filter (post =&gt; post.id not in data:featuredPostIds) : data:posts"
    var="posts"
  >
    <b:loop index="i" values="data:posts" var="post">
      <article class="post">
        <a expr:href="data:post.url">
          <h3 class="card-title">
            <b:eval
              expr='data:post.title.escaped != "" ? data:post.title.escaped : data:messages.noTitle'
            />
          </h3>
        </a>
        <div class="post-excerpt">
          <data:post.snippets.short />
        </div>
        <div class="post-meta">
          <b:include name="iconCalendar" />
          <span>
            <data:post.date />
          </span>
          <b:if cond="data:post.labels">
            <div class="post-labels">
              <b:include name="iconTags" />
              <div class="post-labels-list">
                <b:loop index="i" values="data:post.labels" var="label">
                  <b:if cond='data:label.name != "projects" and data:i lt 2'>
                    <span class="label">
                      <data:label.name />
                    </span>
                  </b:if>
                </b:loop>
              </div>
            </div>
          </b:if>
        </div>
      </article>
    </b:loop>
  </b:with>
</div>
<b:include name="nextPrev" />