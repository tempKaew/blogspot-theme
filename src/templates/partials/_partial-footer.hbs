<footer id="footer">
  <b:section
    id="main-footer"
    cond="!data:view.isLayoutMode"
    maxwidgets="2"
    name="Footer Menu"
    showaddelement="false"
  >
    <b:widget
      id="LinkList1"
      locked="true"
      title="Navigation Menu"
      type="LinkList"
      version="2"
      visible="true"
    >
      <b:widget-settings>
        <b:widget-setting name="sorting">NONE</b:widget-setting>
        <b:widget-setting name="text-0">FacebookPage</b:widget-setting>
        <b:widget-setting
          name="link-0"
        >https://www.facebook.com/tempkaew</b:widget-setting>
        <b:widget-setting name="text-1">Github</b:widget-setting>
        <b:widget-setting
          name="link-1"
        >https://github.com/tempKaew</b:widget-setting>
        <b:widget-setting name="text-2">CodePen</b:widget-setting>
        <b:widget-setting
          name="link-2"
        >https://codepen.io/tempKaew</b:widget-setting>
      </b:widget-settings>
      <b:includable id="main">
        <div>
          &#169;
          <span id="getYear">{{currentYear}}</span>
          &#8231;
          <a expr:href="data:blog.homepageUrl.canonical"><data:blog.title
            /></a>. All rights reserved.
        </div>
        <div>
          <ul
            class="main-menu-list"
            itemscope="itemscope"
            itemtype="https://schema.org/SiteNavigationElement"
          >
            <b:loop values="data:links" var="link">
              <b:if cond="data:link.name == &quot;BreakLine&quot;">
                <li class="break" />
                <b:else />
                <li>
                  <a
                    class="link"
                    expr:href="data:link.target"
                    itemprop="url"
                    target="_blank"
                    title="{{data:link.name}}"
                  >
                    <b:if cond="data:link.name == &quot;FacebookPage&quot;">
                      <b:include name="iconFacebook" />
                    </b:if>
                    <b:if cond="data:link.name == &quot;Github&quot;">
                      <b:include name="iconGithub" />
                    </b:if>
                    <b:if cond="data:link.name == &quot;CodePen&quot;">
                      <b:include name="iconCodePen" />
                    </b:if>
                  </a>
                </li>
              </b:if>
            </b:loop>
          </ul>
        </div>
      </b:includable>
    </b:widget>
  </b:section>
</footer>