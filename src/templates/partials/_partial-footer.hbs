<footer class="site-footer" id="footer">
  <b:section
    id="main-footer"
    cond="!data:view.isLayoutMode"
    maxwidgets="2"
    name="Footer Menu"
    showaddelement="false"
  >
    <b:widget
      id="LinkList1"
      locked="true"
      title="Navigation Menu"
      type="LinkList"
      version="2"
      visible="true"
    >
      <b:widget-settings>
        <b:widget-setting name="sorting">NONE</b:widget-setting>
        <b:widget-setting name="text-0">FacebookPage</b:widget-setting>
        <b:widget-setting
          name="link-0"
        >https://www.facebook.com/tempkaew</b:widget-setting>
        <b:widget-setting name="text-1">Github</b:widget-setting>
        <b:widget-setting
          name="link-1"
        >https://github.com/tempKaew</b:widget-setting>
        <b:widget-setting name="text-2">LinkedIn</b:widget-setting>
        <b:widget-setting
          name="link-2"
        >https://www.linkedin.com/in/tempkaew</b:widget-setting>
        <b:widget-setting name="text-3">CodePen</b:widget-setting>
        <b:widget-setting
          name="link-3"
        >https://codepen.io/tempKaew</b:widget-setting>
        <b:widget-setting name="text-4">LeetCode</b:widget-setting>
        <b:widget-setting
          name="link-4"
        >https://leetcode.com/u/tempkaew/</b:widget-setting>
      </b:widget-settings>
      <b:includable id="main">
        <div class="site-footer__inner">
          <div class="site-footer__brand">
            <div class="site-footer__name">
              <a expr:href="data:blog.homepageUrl.canonical"><data:blog.title /></a>
              <span class="badge">v1.0</span>
            </div>
            <p class="site-footer__copy">&#169; {{currentYear}} tempKAEW. Crafted for modern web engineering.</p>
          </div>
          <nav class="site-footer__nav" aria-label="Footer">
            <a href="https://tempkaew.blogspot.com/p/about.html">About</a>
            <a href="https://tempkaew.blogspot.com/search/label/projects">Projects</a>
            <a href="https://tempkaew.blogspot.com/search?max-results=8">Blog</a>
            <a href="https://tempkaew.blogspot.com/search/label/studyLog">StudyLog</a>
            <a href="https://tempkaew.blogspot.com/p/privacy-policy.html">Privacy Policy</a>
            <a href="https://tempkaew.blogspot.com/p/cookie-policy.html">Terms</a>
          </nav>
          <ul class="social-list">
            <b:loop values="data:links" var="link">
              <li>
                <a expr:href="data:link.target" expr:title="data:link.name" target="_blank" rel="noopener noreferrer">
                  <b:if cond="data:link.name == &quot;FacebookPage&quot;">
                    <b:include name="iconFacebook" />
                  </b:if>
                  <b:if cond="data:link.name == &quot;Github&quot;">
                    <b:include name="iconGithub" />
                  </b:if>
                  <b:if cond="data:link.name == &quot;CodePen&quot;">
                    <b:include name="iconCodePen" />
                  </b:if>
                  <b:if cond="data:link.name == &quot;LinkedIn&quot;">
                    <b:include name="iconLinkedIn" />
                  </b:if>
                  <b:if cond="data:link.name == &quot;LeetCode&quot;">
                    <b:include name="iconLeetCode" />
                  </b:if>
                </a>
              </li>
            </b:loop>
            <li>
              <a href="https://tempkaew.blogspot.com/feeds/posts/default?alt=rss" target="_blank" rel="noopener noreferrer" title="RSS">
                <b:include name="iconFreed" />
              </a>
            </li>
          </ul>
        </div>
      </b:includable>
    </b:widget>
  </b:section>
</footer>